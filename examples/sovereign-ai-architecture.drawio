        <object id="e-extai" label="External AI Services" type="entity" purpose="Specialised external models, research services and tools (where allowed)" sensitivity="Public" auth="API keys" trust="Untrusted external (outside the sovereign boundary)" crown_jewel="no"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#41719C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1955" y="743" width="130" height="64" as="geometry"/></mxCell></object>
