        <object id="e-extdata" label="External Data Providers" type="entity" purpose="News, research and other licensed external data feeds supplied to the platform" sensitivity="Public / licensed data" auth="Provider-issued SFTP keys and API tokens (assumed)" trust="Untrusted external (outside the sovereign boundary)" crown_jewel="no"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#41719C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="65" y="148" width="130" height="64" as="geometry"/></mxCell></object>
        <object id="e-partners" label="Intl Partners &amp; Model Collaborators" type="entity" purpose="Trusted international partners and academia exchanging models and data under agreement" sensitivity="Confidential — shared models and datasets" auth="Federated partner accounts (assumed)" trust="Semi-trusted external (outside the sovereign boundary)" crown_jewel="no"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#41719C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="435" y="148" width="130" height="64" as="geometry"/></mxCell></object>
        <object id="e-agencies" label="Government Agencies &amp; Statutory Boards" type="entity" purpose="Domestic government users of the AI services" sensitivity="Internal" auth="Government single sign-on (assumed)" trust="Trusted domestic users reaching the platform over the Internet" crown_jewel="no"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#41719C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="840" y="98" width="130" height="64" as="geometry"/></mxCell></object>
        <object id="e-public" label="Citizens, Enterprises &amp; Researchers" type="entity" purpose="Public users of citizen-facing AI services" sensitivity="Public" auth="National digital identity or public accounts (assumed)" trust="Untrusted public (Internet)" crown_jewel="no"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#41719C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="840" y="178" width="130" height="64" as="geometry"/></mxCell></object>
        <object id="e-edge" label="Edge Security (WAF, DDoS, API)" type="process" purpose="Internet-facing WAF, DDoS protection, firewall / SSL-VPN and API gateway terminating all inbound traffic" sensitivity="Confidential — TLS keys and all inbound traffic in transit" auth="Appliance admin accounts; mutual TLS to back ends (assumed)" trust="DMZ — exposed to the Internet" crown_jewel="no"><mxCell style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=none;strokeColor=#41719C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1161" y="141" width="108" height="108" as="geometry"/></mxCell></object>
        <object id="e-authdata" label="Authorised External Data" type="datastore" purpose="Vetted partner and licensed data staged for ingestion" sensitivity="Confidential — licensed third-party data" auth="Ingestion service accounts (assumed)" trust="Trusted internal (data sources zone)" crown_jewel="no"><mxCell style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=none;strokeColor=#41719C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="41" y="352" width="128" height="86" as="geometry"/></mxCell></object>
        <object id="e-govdata" label="Government Data (citizen, national)" type="datastore" purpose="Citizen, national and public-sector source data" sensitivity="Restricted — PII and national security data" auth="Agency service accounts and API keys (assumed)" trust="Trusted internal" crown_jewel="yes"><mxCell style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=none;strokeColor=#41719C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="41" y="502" width="128" height="86" as="geometry"/></mxCell></object>
        <object id="e-entdata" label="Enterprise &amp; Open Data" type="datastore" purpose="Business, operational and open data held within the country" sensitivity="Internal — business and open data" auth="Service accounts (assumed)" trust="Trusted internal" crown_jewel="no"><mxCell style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=none;strokeColor=#41719C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="41" y="627" width="128" height="86" as="geometry"/></mxCell></object>
        <object id="e-ot" label="OT / IoT Sensor Sources" type="entity" purpose="Smart-city and critical-infrastructure sensor streams" sensitivity="Internal — operational telemetry" auth="Device certificates (assumed)" trust="Semi-trusted devices" crown_jewel="no"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#41719C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="753" width="130" height="64" as="geometry"/></mxCell></object>
        <object id="e-ingest" label="Data Ingestion" type="process" purpose="API, batch and streaming connectors that pull data from the source systems" sensitivity="Confidential — carries citizen and agency data in transit" auth="Connector service accounts and API keys" trust="Trusted internal" crown_jewel="no"><mxCell style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=none;strokeColor=#41719C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="411" y="381" width="108" height="108" as="geometry"/></mxCell></object>
        <object id="e-process" label="Data Processing" type="process" purpose="ETL, cleansing, labelling and vectorisation of ingested data" sensitivity="Confidential — personal and proprietary training data being prepared" auth="Pipeline service accounts (assumed)" trust="Trusted internal" crown_jewel="no"><mxCell style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=none;strokeColor=#41719C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="411" y="556" width="108" height="108" as="geometry"/></mxCell></object>
        <object id="e-lake" label="Data Lake / Feature Store" type="datastore" purpose="Raw and curated data, features, embeddings and metadata; also the retrieval (RAG) index" sensitivity="Restricted — PII and proprietary training datasets" auth="IAM roles and service accounts" trust="Trusted internal" crown_jewel="yes"><mxCell style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=none;strokeColor=#41719C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="401" y="732" width="128" height="86" as="geometry"/></mxCell></object>
        <object id="e-dev" label="Model Development" type="process" purpose="IDE, notebooks and experimentation for data scientists" sensitivity="Confidential — model architecture, code and prompts" auth="Single sign-on and SSH keys (assumed)" trust="Trusted internal" crown_jewel="no"><mxCell style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=none;strokeColor=#41719C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="756" y="381" width="108" height="108" as="geometry"/></mxCell></object>
        <object id="e-train" label="Model Training" type="cluster" purpose="Distributed training of foundation and domain models" sensitivity="Confidential — model checkpoints and training data in use" auth="Scheduler service accounts (assumed)" trust="Trusted internal" crown_jewel="no"><mxCell style="ellipse;shape=doubleEllipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=none;strokeColor=#41719C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="751" y="551" width="118" height="118" as="geometry"/></mxCell></object>
        <object id="e-registry" label="Model Registry" type="datastore" purpose="Versioned models, lineage and metadata" sensitivity="Secret — foundation and fine-tuned model weights and model IP" auth="CI/CD service accounts with role-based access" trust="Trusted internal" crown_jewel="yes"><mxCell style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=none;strokeColor=#41719C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="746" y="732" width="128" height="86" as="geometry"/></mxCell></object>
        <object id="e-apps" label="AI Applications" type="process" purpose="Chat, analytics, decision-support and operational AI applications built on the models (agents with tool access)" sensitivity="Restricted — user prompts, AI outputs and decisions" auth="User single sign-on; service tokens to inference" trust="Trusted internal — reachable from the Internet through Edge Security" crown_jewel="yes"><mxCell style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=none;strokeColor=#41719C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1116" y="381" width="108" height="108" as="geometry"/></mxCell></object>
        <object id="e-infer" label="Model Inference Services" type="cluster" purpose="LLM, foundation and domain model serving (API, batch and real-time)" sensitivity="Confidential — model weights in memory, prompts and responses" auth="Service-to-service tokens (assumed)" trust="Trusted internal" crown_jewel="no"><mxCell style="ellipse;shape=doubleEllipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=none;strokeColor=#41719C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1111" y="716" width="118" height="118" as="geometry"/></mxCell></object>
        <object id="e-monitor" label="Monitoring &amp; Observability" type="process" purpose="Model performance, safety, bias and usage monitoring" sensitivity="Internal — telemetry and usage data" auth="Service accounts (assumed)" trust="Trusted management plane" crown_jewel="no"><mxCell style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=none;strokeColor=#41719C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1426" y="381" width="108" height="108" as="geometry"/></mxCell></object>
        <object id="e-secops" label="Security Operations (IAM, SIEM)" type="cluster" purpose="Identity and access management, key management, threat detection and SIEM" sensitivity="Confidential — identity data and security telemetry" auth="Privileged admin accounts with MFA (assumed)" trust="Trusted management plane" crown_jewel="no"><mxCell style="ellipse;shape=doubleEllipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=none;strokeColor=#41719C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1421" y="551" width="118" height="118" as="geometry"/></mxCell></object>
        <object id="e-admins" label="Privileged Administrators" type="entity" purpose="Platform, infrastructure and security administrators" sensitivity="Internal" auth="Privileged access management with MFA" trust="Trusted insiders (management plane)" crown_jewel="no"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#41719C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1415" y="743" width="130" height="64" as="geometry"/></mxCell></object>
        <object id="e-aiops" label="AI Operations (MLOps / LLMOps)" type="process" purpose="CI/CD pipelines that import, promote and deploy models; LLMOps tooling" sensitivity="Confidential — pipeline secrets and deployment credentials" auth="Pipeline service accounts and tokens" trust="Trusted management plane" crown_jewel="no"><mxCell style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=none;strokeColor=#41719C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1686" y="721" width="108" height="108" as="geometry"/></mxCell></object>
        <object id="e-kms" label="Key Mgmt &amp; Secrets (HSM / KMS)" type="datastore" purpose="Encryption keys and secrets for the platform" sensitivity="Secret — private keys and credentials" auth="HSM partitions; KMIP / PKCS#11 client certificates" trust="Trusted management plane" crown_jewel="yes"><mxCell style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=none;strokeColor=#41719C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1676" y="567" width="128" height="86" as="geometry"/></mxCell></object>
